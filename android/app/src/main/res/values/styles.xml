<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="W">
        <item name="android:textColor">@color/text</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="W.Title">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="W.Small">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/secondary</item>
    </style>
    <style name="W.Label">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent</item>
    </style>
    <style name="W.LabelMuted" parent="W.Label">
        <item name="android:textColor">@color/secondary</item>
    </style>
    <style name="W.Big">
        <item name="android:textSize">24sp</item>
        <item name="android:autoSizeMaxTextSize">24sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="W.BigSmall" parent="W.Big">
        <item name="android:textSize">27sp</item>
        <item name="android:autoSizeMaxTextSize">27sp</item>
    </style>
    <style name="W.BigCompact" parent="W.Big">
        <item name="android:textSize">17sp</item>
        <item name="android:autoSizeMaxTextSize">17sp</item>
    </style>
    <style name="W.Unit">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/secondary</item>
    </style>
    <style name="W.Chip">
        <item name="android:textSize">10sp</item>
    </style>
    <style name="W.Foot">
        <item name="android:textSize">9.5sp</item>
        <item name="android:textColor">@color/secondary</item>
    </style>

    <style name="SettingsHeading" parent="@android:style/Widget.Material.TextView">
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="SettingsLabel" parent="@android:style/Widget.Material.TextView">
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="SettingsBody" parent="@android:style/Widget.Material.TextView">
        <item name="android:textColor">@color/secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="SettingsField" parent="@android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/settings_field</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
    <style name="SettingsButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/settings_button</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
