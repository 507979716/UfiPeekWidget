<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_bg"
            android:padding="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/traffic_daily_bg"
                android:padding="11dp"
                android:src="@drawable/ic_router"
                android:tint="@color/accent"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingsHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/app_name"
                    android:textSize="28sp" />

                <TextView
                    style="@style/SettingsBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_subtitle" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/settings_card"
            android:padding="16dp">

            <TextView
                style="@style/SettingsHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/settings_connection" />

            <TextView
                style="@style/SettingsBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_connection_hint" />

            <TextView
                style="@style/SettingsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@+id/et_url"
                android:text="@string/settings_address" />

            <EditText
                android:id="@id/et_url"
                style="@style/SettingsField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/default_backend_address"
                android:inputType="textUri"
                android:importantForAutofill="no"
                android:singleLine="true" />

            <TextView
                style="@style/SettingsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:labelFor="@+id/et_password"
                android:text="@string/settings_password" />

            <EditText
                android:id="@id/et_password"
                style="@style/SettingsField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/settings_password_hint"
                android:inputType="textPassword"
                android:importantForAutofill="no"
                android:singleLine="true" />

            <TextView
                style="@style/SettingsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:labelFor="@+id/et_zte"
                android:text="@string/settings_zte_password" />

            <EditText
                android:id="@id/et_zte"
                style="@style/SettingsField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/settings_zte_password_hint"
                android:inputType="textPassword"
                android:importantForAutofill="no"
                android:singleLine="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <Button
                    android:id="@+id/btn_test"
                    style="@style/SettingsButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/settings_test" />

                <Button
                    android:id="@+id/btn_save"
                    style="@style/SettingsButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/settings_button_primary"
                    android:textColor="@color/on_accent"
                    android:text="@string/settings_save" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_status"
                style="@style/SettingsBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/SettingsHeading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/settings_preview" />

            <TextView
                android:id="@+id/preview_sample"
                style="@style/SettingsBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/traffic_daily_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="@string/settings_sample" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="144dp"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/settings_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/SettingsHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/settings_add_widget" />

            <TextView
                style="@style/SettingsBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings_widget_help" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
