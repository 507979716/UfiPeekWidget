<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UFI-TOOLS 连接"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:text="和 UfiPeek 脚本的三个设置项一致，公网地址、局域网地址都可以。"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="后台地址"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://192.168.0.1:2333"
            android:inputType="textUri"
            android:importantForAutofill="no"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="UFI 密码"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="UFI-TOOLS 后台密码"
            android:inputType="textPassword"
            android:importantForAutofill="no"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="ZTE 密码（与上面不同才填，可留空）"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_zte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="留空则使用 UFI 密码"
            android:inputType="textPassword"
            android:importantForAutofill="no"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_test"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="测试连接" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="保存并刷新" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="小组件预览"
            android:textSize="15sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:alpha="0.8"
            android:lineSpacingExtra="4dp"
            android:text="添加到桌面：\n1. 填好后先点「测试连接」，再点「保存并刷新」。\n2. 回到桌面长按空白处 → 小组件 / 窗口小工具 → 找到 UfiPeek，选「中号 4×2」或「小号 2×2」。\n3. 点小组件任意位置立即刷新；点顶部型号那一行打开本设置页。\n4. 后台大约每 15 分钟自动刷新。小米 / 华为 / OPPO / vivo 等系统请在电池设置里把 UfiPeek 设为「无限制 / 允许后台活动」，否则自动刷新可能被系统拦掉。\n5. 中号小组件拉高时显示完整五行，压扁时自动隐藏 WiFi 那一行（Android 12 及以上）。"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
